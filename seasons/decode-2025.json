  "actions": [
    {
      "id": "none",
      "label": "None",
      "icon": "⬆️",
      "est": 0
    },
    {
      "id": "wait",
      "label": "Wait",
      "icon": "⏱️",
      "est": 1,
      "durationFrom": "time",
      "params": [
        {
          "key": "time",
          "label": "Wait time (sec)",
          "type": "number",
          "default": 1,
          "step": 0.1,
          "min": 0.1
        }
      ],
      "emit": [
        "sleep({time:ms});"
      ]
    },
    {
      "id": "intake",
      "label": "Intake On",
      "icon": "🔄",
      "est": 0.2,
      "emit": [
        "intakeMotor.setPower(1.0);"
      ]
    },
    {
      "id": "intakeOff",
      "label": "Intake Off",
      "icon": "⏹️",
      "est": 0.2,
      "emit": [
        "intakeMotor.setPower(0);"
      ]
    },
    {
      "id": "launch",
      "label": "Launch Artifact",
      "icon": "🚀",
      "est": 1.2,
      "emit": [
        "launchArtifact();"
      ]
    },
    {
      "id": "outtake",
      "label": "Outtake",
      "icon": "📤",
      "est": 0.8,
      "emit": [
        "intakeMotor.setPower(-1.0);",
        "sleep(500);",
        "intakeMotor.setPower(0);"
      ]
    },
    {
      "id": "faceTag",
      "label": "Face AprilTag",
      "icon": "👁️",
      "est": 0.6,
      "params": [
        {
          "key": "tagId",
          "label": "Tag ID",
          "type": "tagId",
          "default": "@myTag"
        }
      ],
      "emit": [
        "faceAprilTag({tagId});"
      ]
    },
    {
      "id": "driveToTag",
      "label": "Drive to AprilTag",
      "icon": "🏷️",
      "est": 1.5,
      "params": [
        {
          "key": "tagId",
          "label": "Tag ID",
          "type": "tagId",
          "default": "@myTag"
        },
        {
          "key": "distance",
          "label": "Distance (in)",
          "type": "number",
          "default": 12,
          "step": 0.5
        }
      ],
      "emit": [
        "driveToAprilTag({tagId}, {distance});"
      ]
    },
    {
      "id": "readMotif",
      "label": "Read MOTIF (obelisk)",
      "icon": "🔍",
      "est": 0.5,
      "emit": [
        "int motif = readObeliskMotif();  // tags 21/22/23 -> GPP, PGP, PPG"
      ]
    },
    {
      "id": "macro",
      "label": "Run Macro",
      "icon": "📋",
      "est": 1,
      "params": [
        {
          "key": "macro",
          "label": "Macro",
          "type": "macro",
          "default": ""
        }
      ],
      "emit": [
        "runMacro(\"{macro}\");"
      ]
    }
  ],
  "codeNotes": [
    "AUTO period is 30 seconds",
    "OBELISK tags 21/22/23 encode the MOTIF and must not be used for navigation"
  ]
